{
  "name": "guardian-ring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Guardian Ring: a public, cited 3D explainer of overhead persistent infrared satellites.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47600 --strictPort",
    "prebuild": "tsx tools/write-pages.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 47601 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "claims": "tsx tools/claims.mjs",
    "claims:audit": "tsx tools/claim-audit-report.mjs",
    "gates": "node tools/gates.mjs",
    "kit:sync": "node tools/kit.mjs sync",
    "kit:check": "node tools/kit.mjs check",
    "models:compress": "node tools/compress-models.mjs",
    "perf:stress": "node tools/perf-stress.mjs"
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "1.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
